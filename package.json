{
	"name": "paris-indoor-soccer-nuxt",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "nuxt dev",
		"build": "nuxt build",
		"build:cloudflare": "NITRO_PRESET=cloudflare_module nuxt build",
		"deploy:cloudflare": "wrangler d1 migrations apply DB --remote --config .output/server/wrangler.json && wrangler deploy --config .output/server/wrangler.json",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"db:generate": "nuxt-db generate",
		"db:migrate": "nuxt-db migrate",
		"lint": "oxlint",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"typecheck": "nuxt typecheck",
		"test": "node --test"
	},
	"dependencies": {
		"@libsql/client": "^0.18.0",
		"@nuxthub/core": "^0.10.8",
		"@nuxtjs/better-auth": "^0.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"better-auth": "^1.7.5",
		"daisyui": "^5.7.43",
		"drizzle-orm": "^0.45.3",
		"nuxt": "^4.5.2",
		"tailwindcss": "^4.3.3",
		"vue": "^3.5.43",
		"vue-router": "^5.3.1"
	},
	"devDependencies": {
		"aws4fetch": "^1.0.20",
		"drizzle-kit": "^0.31.11",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.85.0",
		"typescript": "^6.0.3",
		"vue-tsc": "^3.3.11",
		"wrangler": "^4.136.2"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"packageManager": "pnpm@12.6.0"
}
