# Generate with: openssl rand -hex 32
NUXT_BETTER_AUTH_SECRET=
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# D1 database id (from `wrangler d1 create`). Only for dev against the real D1; Cloudflare builds use the id in nuxt.config.ts.
NUXT_HUB_CLOUDFLARE_DATABASE_ID=

# Set both to make `pnpm dev` use the real D1 instead of .data/db. Account id from `wrangler whoami`;
# token from dash.cloudflare.com/profile/api-tokens with Account → D1 → Edit.
NUXT_HUB_CLOUDFLARE_ACCOUNT_ID=
NUXT_HUB_CLOUDFLARE_API_TOKEN=
